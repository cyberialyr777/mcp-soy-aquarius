# Odoo connection
ODOO_URL=http://tu-servidor-odoo:8069
ODOO_DB=nombre_de_la_base_de_datos
ODOO_USERNAME=tu_usuario@email.com
ODOO_PASSWORD=tu_contraseña_odoo

# Directory for generated Excel reports and audit logs (default: ./outputs)
OUTPUT_DIR=./outputs

# Transporte MCP:
#   streamable-http -> servidor remoto detrás de reverse proxy (default)
#   stdio           -> solo para pruebas locales con Claude Desktop en la misma máquina
MCP_TRANSPORT=streamable-http
# MCP_HOST: 127.0.0.1 para instalación nativa; en Docker se fuerza a 0.0.0.0 desde docker-compose.yml
MCP_HOST=127.0.0.1
MCP_PORT=8080

# Token compartido que exige nginx (header: Authorization: Bearer <MCP_TOKEN>).
# Genera uno largo y aleatorio, ej.: openssl rand -hex 32
# Debe coincidir con el que pongan las laptops en claude_desktop_config.json.
MCP_TOKEN=reemplaza_con_un_token_aleatorio_largo
